# Copy to .env to override docker-compose defaults.
HIGHLIGHT_TIMEZONE=Europe/London
SCENARIO_SEED=20261107
CHAOS_DUPLICATE_RATE=0.02
CHAOS_DELAY_RATE=0.02
# Set to require a bearer token for /api/admin/*
ADMIN_TOKEN=
# Highlight descriptions: local (free, on-device), gemini, or template. Defaults to gemini when
# GEMINI_API_KEY is set, otherwise template. Local needs `brew install llama.cpp whisper-cpp`
# and `npm run captions:server` running (downloads Qwen2.5-VL 7B, ~5 GB, on first start).
CAPTION_PROVIDER=local
# LOCAL_CAPTION_URL=http://127.0.0.1:8081
# LOCAL_CAPTION_MODEL=qwen2.5-vl-7b

# Optional: describe actual highlight video and audio with Gemini (neutral templates otherwise)
GEMINI_API_KEY=AQ.Ab8RN6LxmnjZXUNXwL-cPwXtuMayPtCF3X8q2DmWN_ixP_qzCw
GEMINI_MODEL=gemini-3.6-flash

# Local backend only (export in its process environment); Docker sets its media origin itself.
# MEDIA_FETCH_BASE=http://localhost:5173/media
# FFMPEG_PATH=ffmpeg

# Google sign-in + automatic PUBLIC YouTube Shorts publishing.
# Docker default: http://localhost:8080. Local Vite: http://localhost:5173.
# Generate once with: openssl rand -hex 32 (keep stable; do not commit the key).
# Comma-separated Google account emails authorized to operate this service.
# Local optional: CONTENT_SETTLE_SECONDS=30
CONTENT_APP_URL='http://localhost:5173'
CONTENT_ENCRYPTION_KEY='2234d8cd5c7d703a37ae2193efcaa04e03747fac8628b5d46c4a7743782a9cca'
GOOGLE_CLIENT_ID='251387512246-7ve082l0atro3tguq48063n22bsius1m.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='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'
CONTENT_ALLOWED_EMAILS='sportslite.uk@gmail.com'
